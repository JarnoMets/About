# About Backend Kubernetes Secret Template
# Copy this file to k8s/backend-secret.yaml and fill in your values
apiVersion: v1
kind: Secret
metadata:
  name: about-backend-secret
  namespace: about
type: Opaque
stringData:
  SMTP_HOST: "smtp-relay.brevo.com"
  SMTP_PORT: "587"
  SMTP_USER: "your-smtp-user"
  SMTP_PASS: "your-smtp-password"
  EMAIL_FROM: "form@yourdomain.com"
  EMAIL_TO: "info@yourdomain.com"
  EMAIL_ENABLED: "true"
  HOST: "0.0.0.0"
  PORT: "8080"
  DATABASE_URL: "postgresql://about_user:your-password@postgres.about-db.svc.cluster.local:5432/about_db"
